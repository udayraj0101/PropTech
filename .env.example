# Reelly API — https://docs.reelly.ai
# Server-side only (no NEXT_PUBLIC_ prefix): the key is read inside the
# /api/projects route and never shipped to the browser.
REELLY_API_KEY=

# Optional override — defaults to https://api-reelly.up.railway.app
# REELLY_BASE_URL=https://api-reelly.up.railway.app

# Restrict project listings to the 4 landing-page developers
# (ALDAR, MODON, EAGLE HILLS, AL AIN HOLDING). Default = on.
# Set to "0" to show every project the tenant exposes.
# REELLY_RESTRICT_TO_LANDING=1
